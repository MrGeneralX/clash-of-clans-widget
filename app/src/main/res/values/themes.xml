<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClashTimers" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">#1B1612</item>
        <item name="android:navigationBarColor">#1B1612</item>
        <item name="android:windowBackground">#1B1612</item>
    </style>

    <style name="Theme.ClashTimers.TransparentSync" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
